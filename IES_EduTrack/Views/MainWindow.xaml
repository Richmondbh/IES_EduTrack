<Window x:Class="IES_EduTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IES_EduTrack.ViewModels"
        Title="IES EduTrack — Engelska Skolan Östersund"
        Height="680" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Nav button base style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background"   Value="#2C3E50"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"       Value="48"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Margin"       Value="0,4,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D5166"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="200"/>
            <!-- Main content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <!-- App title -->
                <TextBlock Text="IES EduTrack"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="16,24,16,8"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Engelska Skolan Östersund"
                           Foreground="#95A5A6"
                           FontSize="11"
                           Margin="16,0,16,24"
                           TextWrapping="Wrap"/>

                <Separator Background="#3D5166" Margin="16,0"/>

                <Button Content="👤  Students"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ShowStudentsCommand}"
                        Margin="8,16,8,4"/>

                <Button Content="📋  Attendance"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ShowAttendanceCommand}"
                        Margin="8,4,8,4"/>

                <Button Content="📊  Grades"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ShowGradesCommand}"
                        Margin="8,4,8,4"/>
            </StackPanel>
        </Border>

        <!-- Content area which swaps UserControl based on CurrentViewModel -->
        <Border Grid.Column="1" Background="#F4F6F7">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>