<Application
    x:Class="IES_EduTrack.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IES_EduTrack"
    xmlns:vm="clr-namespace:IES_EduTrack.ViewModels"
    xmlns:views="clr-namespace:IES_EduTrack.Views"
    StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vm:StudentViewModel}">
                <views:StudentView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
                <views:AttendanceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GradeViewModel}">
                <views:GradeView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
